{
  "manifestVersion": 5,
  "id": "com.rayyanshehran.podcut",
  "name": "PodCut",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "podcutPanel",
      "label": { "default": "PodCut" },
      "minimumSize": { "width": 260, "height": 420 },
      "maximumSize": { "width": 1600, "height": 2000 },
      "preferredDockedSize": { "width": 320, "height": 720 },
      "preferredFloatingSize": { "width": 380, "height": 760 }
    }
  ]
}
